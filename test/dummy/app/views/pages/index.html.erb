<% dummy_page_nav(title: "Pages", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Pages",
    subtitle: "Paste a page id into the WordPress Plugin Demo block.",
    variant: :h1
  ) %>

  <% page_rows = @page_recordings.map { |recording|
    {
      title: recording.recordable&.title.presence || "Page",
      recording: recording
    }
  } %>

  <%= render FlatPack::Table::Component.new(data: page_rows, class: "text-sm") do |table| %>
    <% table.column(title: "Title") { |row| link_to row[:title], page_path(row[:recording]) } %>
    <% table.column(title: "Page id") { |row| tag.code(row[:recording].id, class: "font-mono") } %>
  <% end %>
</div>
