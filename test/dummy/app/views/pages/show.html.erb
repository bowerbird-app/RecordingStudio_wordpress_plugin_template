<% dummy_page_nav(title: "WordPress embed preview", back_url: pages_path, back_label: "Pages") %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageNav::Component.new(
    secondary_anchor_href: pages_path,
    secondary_anchor_icon: "chevron-left",
    secondary_anchor_tooltip: "Pages"
  ) %>

  <%= render FlatPack::PageTitle::Component.new(
    title: "WordPress embed preview",
    subtitle: "Compare this host iframe with the WordPress Plugin Demo block.",
    variant: :h1
  ) %>

  <iframe
    title="WordPress embed preview"
    src="<%= embed_preview_page_path(@page_recording) %>"
    class="w-full min-h-[24rem] border-0"
  ></iframe>
</div>
